roach", "label": "Approach", "file_type": "rationale", "source_file": "docs/project.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simple HubSpot client with retries and upserts; deterministic rule-based detectors (not AI) for duplicates and data issues; a synthetic labelled dataset as evidence of detector quality; every CRM write needs approval and is logged; AI only explains results from aggregated counts, never decides or writes."}, {"id": "docs_project_technical_direction", "label": "Technical Direction", "file_type": "concept", "source_file": "docs/project.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_success_criteria", "label": "Success Criteria", "file_type": "concept", "source_file": "docs/project.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_principle", "label": "Guiding Principle", "file_type": "rationale", "source_file": "docs/project.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simple and reliable beats feature-heavy; the goal is a clear, working outcome: audit a messy CRM, report it well, fix it with approval, and show it improved."}], "edges": [{"source": "docs_project_mvp_scope", "target": "docs_roadmap_slice1", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/project.md", "source_location": null, "weight": 1.0}, {"source": "docs_project_mvp_scope", "target": "docs_roadmap_slice2", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/project.md", "source_location": null, "weight": 1.0}, {"source": "docs_project_mvp_scope", "target": "docs_roadmap_slice3", "relation": "conceptually_related_to", "confidence": "INFERRED"