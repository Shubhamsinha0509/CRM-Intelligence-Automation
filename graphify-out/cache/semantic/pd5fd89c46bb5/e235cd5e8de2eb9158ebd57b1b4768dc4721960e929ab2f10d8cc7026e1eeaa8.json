{"nodes": [{"id": "claude_core_rule", "label": "Core Rule: One Task at a Time", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Freelance-oriented audit tool and college major project; the outcome (a clear audit, a good report, approved fixes, a before/after demo) matters more than heavy engineering, so pick the simpler option when in doubt."}, {"id": "claude_before_coding", "label": "Before Coding Workflow", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_during_coding", "label": "During Coding Guidelines", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer the simplest solution that works; reuse existing code and avoid new dependencies/refactors; do not add queues, abstraction layers, or frameworks unless the current task needs them; use deterministic logic for CRM rules and detection; AI is only used to explain results and must never write to the CRM."}, {"id": "claude_crm_hubspot_guidelines", "label": "CRM / HubSpot Guidelines", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep HubSpot calls in one module; check data shape but keep messy values as-is since finding them is the point; retry on 429 and report other API errors clearly; CRM writes need explicit approval and are recorded in a change log; use upserts so re-running a pull is safe; CSV is for dev/test only."}, {"id": "claude_verification", "label": "Verification Steps", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor"