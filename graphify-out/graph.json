      "id": "claude_crm_hubspot_guidelines",
      "label": "CRM / HubSpot Guidelines",
      "author": null,
      "captured_at": null,
      "community": 1,
      "community_name": "HubSpot Module & API Guidelines",
      "contributor": null,
      "file_type": "rationale",
      "norm_label": "crm / hubspot guidelines",
      "rationale": "Keep HubSpot calls in one module; check data shape but keep messy values as-is since finding them is the point; retry on 429 and report other API errors clearly; CRM writes need explicit approval and are recorded in a change log; use upserts so re-running a pull is safe; CSV is for dev/test only.",
      "source_file": "CLAUDE.md",
      "source_location": null,
      "source_url": null
    },
    {
