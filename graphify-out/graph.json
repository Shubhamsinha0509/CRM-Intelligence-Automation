    {
      "id": "claude_during_coding",
      "label": "During Coding Guidelines",
      "author": null,
      "captured_at": null,
      "community": 2,
      "community_name": "Detection Approach & Coding Rules",
      "contributor": null,
      "file_type": "rationale",
      "norm_label": "during coding guidelines",
      "rationale": "Prefer the simplest solution that works; reuse existing code and avoid new dependencies/refactors; do not add queues, abstraction layers, or frameworks unless the current task needs them; use deterministic logic for CRM rules and detection; AI is only used to explain results and must never write to the CRM.",
      "source_file": "CLAUDE.md",
      "source_location": null,
      "source_url": null
    },
    {
      "id": "docs_architecture_ai_summary",
      "label": "AI Summary Component",
      "author": null,
      "captured_at": null,
      "community": 2,
      "community_name": "Detection Approach & Coding Rules",
      "contributor": null,
      "file_type": "rationale",
      "norm_label": "ai summary component",
      "rationale": "An LLM turns aggregated counts and issue types into plain-English explanations; it never sees raw personal data and never writes to HubSpot, limiting AI involvement for privacy and safety.",
      "source_file": "docs/architecture.md",
      "source_location": null,
      "source_url": null
    },
    {
      "id": "docs_architecture_detectors",
      "label": "Detectors Component",
      "author": null,
      "captured_at": null,
      "community": 2,
      "community_name": "Detection Approach & Coding Rules",
      "contributor": null,
      "file_type": "rationale",
      "norm_label": "detectors component",
      "rationale": "Detectors are plain functions that read SQLite and return issues, with no HubSpot calls and no AI, so detection logic stays deterministic and testable independent of the CRM or LLM.",
      "source_file": "docs/architecture.md",
      "source_location": null,
      "source_url": null
    },
    {
      "id": "docs_dataset_and_evaluation_plan_answer_key",
      "label": "Ground Truth Answer Key",
      "author": null,
      "captured_at": null,
      "community": 2,
      "community_name": "Detection Approach & Coding Rules",
      "contributor": null,
      "file_type": "rationale",
      "norm_label": "ground truth answer key",
      "rationale": "Detectors never read the ground-truth file -- only the evaluation script does -- and the generator is a separate script from the detectors, so evaluation does not just test a detector against its own assumptions.",
      "source_file": "docs/dataset-and-evaluation-plan.md",
      "source_location": null,
      "source_url": null
    },
    {
